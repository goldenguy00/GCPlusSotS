<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <NoWarn>1701;1702;IDE0051;CS0618</NoWarn>
    <LangVersion>latestMajor</LangVersion>
  </PropertyGroup>
    
  <ItemGroup>
    <EmbeddedResource Include="Properties\Assets\Aurelionite_s_Blessing.png" />
    <EmbeddedResource Include="Properties\Assets\Golden_Knurl.png" />
    <EmbeddedResource Include="Properties\Assets\Gold_Elite_Icon.png" />
    <EmbeddedResource Include="Properties\Assets\Guardian_s_Eye.png" />
    <EmbeddedResource Include="Properties\Assets\Titanic_Greatsword.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="RoR2BepInExPack" Version="*" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="*-*" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" />
    <PackageReference Include="MMHOOK.RoR2" Version="*" NoWarn="NU1701" />
    <PackageReference Include="R2API.ProcType" Version="*" />
    <PackageReference Include="R2API.RecalculateStats" Version="*" />
    <PackageReference Include="R2API.Prefab" Version="*" />
    <PackageReference Include="R2API.Items" Version="*" />
    <PackageReference Include="R2API.Language" Version="*" />
    <PackageReference Include="R2API.Elites" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MiscFixes">
      <HintPath>..\libs\MiscFixes.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="call &quot;$(MSBuildProjectDirectory)\weave.bat&quot; $(TargetDir) $(AssemblyName)" />
  </Target>
</Project>
